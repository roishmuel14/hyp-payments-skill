{
  "name": "Daily billing",
  "description": "Every day at 09:00 Israel time: runBilling charges the subscriptions that are due, retries failed ones on days 3 and 7, and expires the unpaid ones after the grace days. Create it through the Apps API (POST /api/apps/<id>/workflows, see the Base44 docs); this file is the shape the sync mirrors back.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "Asia/Jerusalem",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily-billing",
      "version": "1.0.0",
      "namespace": "base44"
    },
    "do": [
      {
        "runBilling": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runBilling",
            "args": {
              "trigger": "cron"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}
